{
  "name": "clearinstall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first install-surface auditor for lockfiles and binding.gyp command expansion.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8787",
    "start": "vite preview --host 127.0.0.1 --port 8787 --strictPort",
